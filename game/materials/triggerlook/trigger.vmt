// triggerlook: the triggers' fill and border (colour + alpha per vertex, from the trigger menu), unlit.
// No $decal: its depth bias grows with distance and showed triggers lying a few units UNDER a floor through it.
// Instead the drawn shape is the trigger grown by half a unit (tl_mesh.cpp TL_ExpandModel): a side lying on a floor
// or wall still wins against it, one under it stays hidden.
"UnlitGeneric"
{
	"$basetexture" "vgui/white"
	"$vertexcolor" 1
	"$vertexalpha" 1
	"$translucent" 1
}
